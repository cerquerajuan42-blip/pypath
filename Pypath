.next-btn{width:100%;background:var(--card2);border:1px solid var(--border2);border-radius:var(--r2);padding:.85rem;font-family:var(--mono);font-size:.83rem;font-weight:700;color:var(--mint);display:none;align-items:center;justify-content:center;gap:8px;transition:background .2s}
