.btn-start{width:100%;max-width:340px;background:var(--mint);color:#0B0F1A;border:none;border-radius:var(--r);padding:1rem;font-size:1rem;font-weight:700;font-family:var(--mono);letter-spacing:-.01em;transition:opacity .2s}
