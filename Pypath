<body>

<!-- ── ONBOARDING ── -->
<div id="s-onboard" class="screen active">
  <div class="ob-snake">🐍</div>
  <h1 class="ob-title">Aprende<br/><em>Python</em><br/>de verdad</h1>
  <p class="ob-sub">Ejercicios progresivos, errores explicados y seguimiento real de tu progreso.</p>
  <div class="ob-cards">
    <div class="ob-card">
