.nav-btn-icon{font-size:1.35rem;line-height:1}

/* ── EXERCISE SCREEN ── */
#s-exercise{background:var(--bg)}
.ex-topbar{display:flex;align-items:center;gap:.75rem;padding:.85rem 1.1rem;border-bottom:1px solid var(--border);background:rgba(11,15,26,.92);backdrop-filter:blur(12px);position:sticky;top:0;z-index:50}
