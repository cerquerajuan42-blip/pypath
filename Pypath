// ═══════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════
let state = JSON.parse(localStorage.getItem('pypath_state') || 'null') || {
  started:false, done:{}, xp:0,
  currentExPhase:-1, currentExIdx:-1,
  streak:0, lastDate:null, hintUsed:false
};
function save(){ localStorage.setItem('pypath_state', JSON.stringify(state)); }

const MAX_XP = PHASES.reduce((t,p) => t + p.exercises.reduce((s,e)=>s+e.xp,0),0);

function isDone(phaseId, exIdx){ return !!state.done[`${phaseId}_${exIdx}`]; }
function markDone(phaseId, exIdx, xp){
  const k=`${phaseId}_${exIdx}`;
  if(!state.done[k]){ state.done[k]=true; state.xp+=xp; }
  save();
}

function phaseProgress(p){
  const done = p.exercises.filter((_,i)=>isDone(p.id,i)).length;
  return {done, total:p.exercises.length, pct: Math.round((done/p.exercises.length)*100)};
}

function isPhaseUnlocked(phaseId){
  if(phaseId===0) return true;
  const prev = PHASES[phaseId-1];
  const pp = phaseProgress(prev);
  return pp.done >= Math.ceil(prev.exercises.length * 0.6);
}

function getLevel(){
  const pct = state.xp / MAX_XP;
  if(pct < .1) return {lvl:1, name:'Principiante'};
  if(pct < .25) return {lvl:2, name:'Aprendiz'};
  if(pct < .45) return {lvl:3, name:'Estudiante'};
  if(pct < .65) return {lvl:4, name:'Desarrollador Jr.'};
  if(pct < .85) return {lvl:5, name:'Desarrollador'};
  return {lvl:6, name:'Pythonista 🐍'};
}

function updateStreak(){
  const today = new Date().toDateString();
  if(state.lastDate !== today){
    const yesterday = new Date(Date.now()-86400000).toDateString();
    if(state.lastDate === yesterday) state.streak = (state.streak||0)+1;
    else if(state.lastDate !== today) state.streak = 1;
    state.lastDate = today;
    save();
  }
}

// ═══════════════════════════════════════════════════════
// ONBOARDING
// ═══════════════════════════════════════════════════════
function startApp(){
  state.started = true;
  updateStreak();
  save();
  showScreen('s-main');
  renderMain();
}

// ═══════════════════════════════════════════════════════
// SCREEN ROUTER
// ═══════════════════════════════════════════════════════
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}

let currentTab = 'map';
function showTab(tab){
  currentTab = tab;
  if(tab==='map'){ showScreen('s-main'); renderMain(); }
  else if(tab==='prog'){ showScreen('s-progress'); renderProgress(); }
  else if(tab==='guide'){ showScreen('s-guide'); }
}

// ═══════════════════════════════════════════════════════
// MAIN RENDER
// ═══════════════════════════════════════════════════════
function renderMain(){
  renderHeader();
  renderStats();
  renderPhases();
}

function renderHeader(){
  const pct = MAX_XP ? Math.round((state.xp/MAX_XP)*100) : 0;
  ['hdr-xp','hdr-xp2'].forEach(id=>{ const el=document.getElementById(id); if(el) el.textContent=state.xp+' XP'; });
  const bar = document.getElementById('hdr-bar');
  if(bar) bar.style.width = pct+'%';
}

function renderStats(){
  const totalDone = Object.keys(state.done).length;
  const totalEx = PHASES.reduce((t,p)=>t+p.exercises.length,0);
  const phaseDone = PHASES.filter(p=>phaseProgress(p).done===p.exercises.length).length;
  document.getElementById('stats-row').innerHTML = `
    <div class="stat-box"><div class="stat-n">${totalDone}</div><div class="stat-l">Ejercicios completados</div></div>
    <div class="stat-box"><div class="stat-n">${state.xp}</div><div class="stat-l">XP ganados</div></div>
    <div class="stat-box"><div class="stat-n">${phaseDone}/${PHASES.length}</div><div class="stat-l">Fases completadas</div></div>
  `;
}

function renderPhases(){
  const list = document.getElementById('phases-list');
  list.innerHTML = PHASES.map(p => {
    const pp = phaseProgress(p);
    const unlocked = isPhaseUnlocked(p.id);
    const allDone = pp.done === pp.total;
    const isActive = unlocked && !allDone;
    let phClass = allDone ? 'done' : (isActive ? 'current' : 'locked');
    let badge = allDone ? '<span class="ph-badge done">✓ Completa</span>'
               : isActive ? '<span class="ph-badge current">En progreso</span>'
               : '<span class="ph-badge locked">🔒 Bloqueada</span>';

    const objsHTML = p.exercises.map((ex, i) => {
      const done = isDone(p.id, i);
      const isNextUp = unlocked && !done && p.exercises.slice(0,i).every((_,j)=>isDone(p.id,j));
      const isLocked = !unlocked || (!done && !isNextUp && !p.exercises.slice(0,i).every((_,j)=>isDone(p.id,j)) && i>0 && !isDone(p.id,i-1));
      let cls = done ? 'done-obj' : (isNextUp ? 'active-obj' : (isLocked ? 'locked-obj' : ''));
      let check = done ? '✓' : (isNextUp ? '▶' : '');
      const onclick = (!isLocked || done) ? `onclick="openExercise(${p.id},${i})"` : '';
      return `<div class="obj-item ${cls}" ${onclick}>
        <div class="obj-check">${check}</div>
        <div class="obj-txt">${ex.title}</div>
        <span class="obj-xp">${done?'✓':'+'}${ex.xp} XP</span>
      </div>`;
    }).join('');

    const startBtn = isActive ? `<button class="ph-start-btn" onclick="openExercise(${p.id}, ${pp.done < pp.total ? pp.done : 0})">
      ${pp.done > 0 ? 'Continuar fase →' : 'Empezar fase →'}
    </button>` : '';

    return `<div class="phase-card ${phClass}" id="phase-card-${p.id}">
      <div class="ph-header" onclick="togglePhase(${p.id})">
        <div class="ph-icon ${phClass}">${p.emoji}</div>
        <div class="ph-info">
          <div class="ph-name">${p.id+1}. ${p.name}</div>
          <div class="ph-meta">${p.label} · ${pp.done}/${pp.total} completados</div>
        </div>
        ${badge}
      </div>
      <div class="ph-progress"><div class="ph-progress-fill" style="width:${pp.pct}%"></div></div>
      <div class="ph-body ${isActive ? 'open' : ''}" id="ph-body-${p.id}">
        <p class="ph-desc">${p.desc}</p>
        <div class="obj-list">${objsHTML}</div>
        ${startBtn}
      </div>
    </div>`;
  }).join('');
}

function togglePhase(id){
  const body = document.getElementById('ph-body-'+id);
  body.classList.toggle('open');
}

// ═══════════════════════════════════════════════════════
// EXERCISE
// ═══════════════════════════════════════════════════════
let currentHintIdx = 0;

function openExercise(phaseId, exIdx){
  const phase = PHASES[phaseId];
  if(!isPhaseUnlocked(phaseId)) return;
  const ex = phase.exercises[exIdx];
  if(!ex) return;

  state.currentExPhase = phaseId;
  state.currentExIdx = exIdx;
  state.hintUsed = false;
  currentHintIdx = 0;

  const pp = phaseProgress(phase);
  const exNum = exIdx + 1;
  const totalEx = phase.exercises.length;
  const progPct = Math.round((exIdx / totalEx) * 100);

  document.getElementById('ex-phase-label').textContent = `Fase ${phaseId+1}: ${phase.name}`;
  document.getElementById('ex-title').textContent = ex.title;
  document.getElementById('ex-xp-badge').textContent = `+${ex.xp} XP`;
  document.getElementById('ex-prog-fill').style.width = progPct+'%';
  document.getElementById('ex-prog-label').textContent = `${exNum} / ${totalEx}`;
  document.getElementById('ex-concept').innerHTML = ex.concept;
  document.getElementById('ex-task').textContent = ex.task;
  document.getElementById('ex-code').value = isDone(phaseId, exIdx) ? ex.starter : ex.starter;

  const fb = document.getElementById('feedback-box');
  fb.className = 'feedback-box';
  fb.style.display = 'none';

  const nextBtn = document.getElementById('next-btn');
  nextBtn.className = 'next-btn';

  if(isDone(phaseId, exIdx)){
    showFeedback('ok','✅ Ya completado','Puedes revisar el ejercicio o practicar de nuevo. El XP ya fue acreditado.');
    const hasNext = exIdx + 1 < phase.exercises.length || phaseId + 1 < PHASES.length;
    if(hasNext){ nextBtn.className = 'next-btn visible'; }
  }

  document.getElementById('btn-run').disabled = false;
  showScreen('s-exercise');
}

function closeExercise(){
  showTab('map');
}

function runCode(){
  const phase = PHASES[state.currentExPhase];
  const ex = phase.exercises[state.currentExIdx];
  const code = document.getElementById('ex-code').value.trim();

  if(!code || code === ex.starter.trim()){
    showFeedback('hint','💡 Escribe tu código','Edita el área de código arriba antes de ejecutar.');
    return;
  }

  const result = ex.validate(code);

  if(result.ok){
    const wasAlreadyDone = isDone(state.currentExPhase, state.currentExIdx);
    markDone(state.currentExPhase, state.currentExIdx, ex.xp);
    updateStreak();
    renderHeader();
    renderStats();

    if(!wasAlreadyDone) showToast(`⚡ +${ex.xp} XP ganados!`);

    showFeedback('ok', '✅ ¡Correcto!', result.msg);
    document.getElementById('next-btn').className = 'next-btn visible';

    const phase = PHASES[state.currentExPhase];
    const pp = phaseProgress(phase);
    if(pp.done === pp.total && !wasAlreadyDone){
      setTimeout(()=>showPhaseComplete(state.currentExPhase), 1200);
    }
  } else {
    let errorHTML = result.msg;
    if(result.err) errorHTML += `<div class="fb-error-line">🔴 ${result.err}</div>`;
    showFeedback('error', '❌ Hay un error', errorHTML);
  }
}

function showHint(){
  const phase = PHASES[state.currentExPhase];
  const ex = phase.exercises[state.currentExIdx];
  const hints = ex.hints;
  const hint = hints[currentHintIdx % hints.length];
  currentHintIdx++;
  state.hintUsed = true;
  showFeedback('hint-fb', `💡 Pista ${Math.min(currentHintIdx, hints.length)}/${hints.length}`, hint);
}

function showFeedback(type, head, body){
  const fb = document.getElementById('feedback-box');
  fb.className = 'feedback-box visible ' + type;
  fb.style.display = 'block';
  document.getElementById('fb-head-text').textContent = '';
  document.getElementById('fb-head-text').innerHTML = head;
  document.getElementById('fb-body').innerHTML = body;
  fb.scrollIntoView({behavior:'smooth', block:'nearest'});
}

function nextExercise(){
  const phase = PHASES[state.currentExPhase];
  const nextExIdx = state.currentExIdx + 1;

  if(nextExIdx < phase.exercises.length){
    openExercise(state.currentExPhase, nextExIdx);
  } else {
    const nextPhaseId = state.currentExPhase + 1;
    if(nextPhaseId < PHASES.length && isPhaseUnlocked(nextPhaseId)){
      openExercise(nextPhaseId, 0);
    } else {
      closeExercise();
    }
  }
}

// ═══════════════════════════════════════════════════════
// PHASE COMPLETE
// ═══════════════════════════════════════════════════════
function showPhaseComplete(phaseId){
  const phase = PHASES[phaseId];
  const phaseXP = phase.exercises.reduce((t,e)=>t+e.xp,0);
  const isLast = phaseId === PHASES.length - 1;
  document.getElementById('co-emoji').textContent = isLast ? '🏆' : '🎉';
  document.getElementById('co-title').textContent = isLast ? '¡Curso completado!' : `Fase ${phaseId+1} completada`;
  document.getElementById('co-sub').textContent = isLast
    ? `¡Has completado todo el curso de Python! Ya tienes las bases para construir proyectos reales.`
    : `Completaste "${phase.name}". ${isPhaseUnlocked(phaseId+1) ? 'La siguiente fase está desbloqueada.' : ''}`;
  document.getElementById('co-xp').textContent = `+${phaseXP} XP`;
  const nextBtn = document.querySelector('.btn-next-phase');
  if(isLast || !isPhaseUnlocked(phaseId+1)){
    nextBtn.textContent = 'Volver al mapa';
    nextBtn.onclick = ()=>closeComplete(false);
  } else {
    nextBtn.textContent = 'Continuar a la siguiente fase →';
    nextBtn.onclick = ()=>closeComplete(true);
  }
  document.getElementById('complete-overlay').classList.add('visible');
  showScreen('s-exercise');
  document.getElementById('complete-overlay').style.display='flex';
}

function closeComplete(goNext){
  document.getElementById('complete-overlay').classList.remove('visible');
  document.getElementById('complete-overlay').style.display='none';
  if(goNext){
    const nextId = state.currentExPhase + 1;
    if(nextId < PHASES.length) openExercise(nextId, 0);
    else closeExercise();
  } else {
    closeExercise();
  }
}

