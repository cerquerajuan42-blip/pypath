// PROGRESS SCREEN
// ═══════════════════════════════════════════════════════
function renderProgress(){
  renderHeader();
  const lvl = getLevel();
  const pct = MAX_XP ? Math.round((state.xp/MAX_XP)*100) : 0;

  document.getElementById('prog-level').textContent = `Nivel ${lvl.lvl} — ${lvl.name}`;

  const nextPhase = PHASES.find(p=>!isPhaseUnlocked(p.id));
  document.getElementById('prog-sub').textContent = nextPhase
    ? `Completa más ejercicios para desbloquear ${nextPhase.name}`
    : '¡Has desbloqueado todas las fases!';

  document.getElementById('prog-big-fill').style.width = pct+'%';
  document.getElementById('prog-xp-label').textContent = `${state.xp} / ${MAX_XP} XP totales`;

  document.getElementById('hdr-xp2').textContent = state.xp + ' XP';

  document.getElementById('streak-num').textContent = `${state.streak||0} día${state.streak!==1?'s':''}`;

  const days = ['L','M','X','J','V','S','D'];
  const today = new Date().getDay();
  document.getElementById('streak-days').innerHTML = days.map((d,i)=>{
    const idx = (i+1)%7;
    const isToday = idx === today;
    const cls = isToday ? 'done-day' : (i < (state.streak||0) % 7 ? 'done-day' : 'empty');
    return `<div class="streak-day ${cls}">${d}</div>`;
  }).join('');

  document.getElementById('prog-phase-list').innerHTML = PHASES.map(p=>{
    const pp = phaseProgress(p);
    const unlocked = isPhaseUnlocked(p.id);
    return `<div class="prog-phase-row">
      <div class="prog-phase-icon">${p.emoji}</div>
      <div class="prog-phase-info">
        <div class="prog-phase-name">${p.name}</div>
        <div class="prog-phase-bar"><div class="prog-phase-bar-fill" style="width:${unlocked?pp.pct:0}%"></div></div>
      </div>
      <div class="prog-phase-count" style="color:${pp.done===pp.total?'var(--mint)':'var(--muted)'}">${unlocked?pp.done+'/'+pp.total:'🔒'}</div>
    </div>`;
  }).join('');
}

