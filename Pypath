.ex-xp-badge{font-family:var(--mono);font-size:.7rem;font-weight:700;color:var(--indigo);background:rgba(129,140,248,.12);border:1px solid rgba(129,140,248,.2);padding:4px 10px;border-radius:99px;white-space:nowrap;flex-shrink:0}

